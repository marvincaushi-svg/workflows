# Stable, non-secret installation identifier shared by all tenant adapters.
WORKFLOWOS_TENANT_ID=

# Optional Hostpoint transport. Every identity field is tenant-configurable.
# Copy to .env.local and keep the real password out of Git.
WORKFLOWOS_SMTP_HOST=asmtp.mail.hostpoint.ch
WORKFLOWOS_SMTP_PORT=587
WORKFLOWOS_SMTP_USERNAME=
WORKFLOWOS_SMTP_PASSWORD=
WORKFLOWOS_SMTP_FROM=
WORKFLOWOS_SMTP_FROM_NAME=
WORKFLOWOS_ORGANIZATION_ROLE=

# Gmail transport is tenant-configurable. Store GMAIL_SMTP_PASSWORD only in
# the deployment secret store, never in this file.
WORKFLOWOS_GMAIL_USERNAME=
WORKFLOWOS_GMAIL_FROM=
WORKFLOWOS_GMAIL_FROM_NAME=
WORKFLOWOS_GMAIL_HOST=smtp.gmail.com
WORKFLOWOS_GMAIL_PORT=587
WORKFLOWOS_GMAIL_TIMEOUT_SECONDS=30
WORKFLOWOS_GMAIL_LIVE_ENABLED=false
WORKFLOWOS_SMTP_TIMEOUT_SECONDS=30

# Read-only Monday collector. Keep the token in the deployment secret store.
# Column ids and the board id belong to the tenant profile, not product code.
MONDAY_API_TOKEN=
WORKFLOWOS_MONDAY_BOARD_ID=
WORKFLOWOS_MONDAY_DOCUMENT_COLUMNS='{"tag_column":"tag_grid_connection_application","ia_column":"installation_notice_ia","schema_column":"single_line_diagram","sina_column":"safety_report_rasi_sina"}'
WORKFLOWOS_MONDAY_ASSET_HOSTS=prod-euc1-files-monday-com.s3.eu-central-1.amazonaws.com

# Third safety switch. Keep false until the controlled SMTP test succeeds.
WORKFLOWOS_SMTP_LIVE_ENABLED=false
