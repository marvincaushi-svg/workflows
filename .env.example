# Hostpoint SMTP. Copy to .env.local and keep the real password out of Git.
WORKFLOWOS_SMTP_HOST=asmtp.mail.hostpoint.ch
WORKFLOWOS_SMTP_PORT=587
WORKFLOWOS_SMTP_USERNAME=Marvin.Caushi@elektro-af.ch
WORKFLOWOS_SMTP_PASSWORD=
WORKFLOWOS_SMTP_FROM=Marvin.Caushi@elektro-af.ch
WORKFLOWOS_SMTP_FROM_NAME="A&F Elektro GmbH"
WORKFLOWOS_SMTP_TIMEOUT_SECONDS=30

# Third safety switch. Keep false until the controlled SMTP test succeeds.
WORKFLOWOS_SMTP_LIVE_ENABLED=false
